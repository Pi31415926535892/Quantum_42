// ============================================================
// L298N MOTOR SERIAL TEST — standalone bench polarity reference
// ============================================================
// Flash this ALONE on a bare Mega to verify drivetrain wiring. It deliberately
// includes no src/rescue_robot headers: it must work without the firmware
// tree, which is the whole point of a bench reference.
//
// It DOES restate the pin table from src/rescue_robot/config.h verbatim.
// Physical ground truth (HARDWARE.md section 2): the LEFT motor pair is on
// L298N channel B, the RIGHT pair on channel A. An earlier version of this
// sketch named the constants the other way round, which crossed the two PWM
// channels and drove channel B in reverse, so an equal "150,150" made the
// robot spin instead of drive. test/bench_remap_test.cpp compares these
// constants against config.h so the two copies cannot silently drift apart.
//
// L298N forward is input-1 HIGH / input-2 LOW on both channels, so a positive
// speed drives the robot forward on BOTH sides here exactly as it does in
// motors.ino.
//
// Type: leftSpeed,rightSpeed   (comma or space separated)
// Range: -255 to 255
// Example: 150,150
//
// Bench checklist (HARDWARE.md section 7), 115200 baud:
//   150,150   straight forward
//   150,-150  pivot in place
//   -150,150  pivot the other way
//   150,50    arc
//   0,0       stop
//
// If one side still spins backwards after this remap, swap that channel's two
// IN constants (or its two motor leads) and update config.h to match.
// ============================================================

// ============================================================
// L298N PINS — must match src/rescue_robot/config.h
// ============================================================

const uint8_t LEFT_IN1  = 4;  // IN3 (Ch B input 1)
const uint8_t LEFT_IN2  = 2;  // IN4 (Ch B input 2)
const uint8_t LEFT_PWM  = 6;  // ENB (Ch B enable)

const uint8_t RIGHT_IN1 = 3;  // IN1 (Ch A input 1)
const uint8_t RIGHT_IN2 = 5;  // IN2 (Ch A input 2)
const uint8_t RIGHT_PWM = 7;  // ENA (Ch A enable)

// Full-scale PWM duty this sketch accepts. Matches MOTOR_MAX_SPEED in
// config.h so a bench verdict transfers to the running firmware unchanged.
const int MAX_SPEED = 200;

// ============================================================
// MOTOR CONTROL
// ============================================================

// Drive one channel. Positive is forward (in1 HIGH, in2 LOW), negative is
// reverse, zero coasts with both direction pins LOW.
void driveChannel(int in1, int in2, int pwm, int speed)
{
  speed = constrain(speed, -MAX_SPEED, MAX_SPEED);

  if (speed > 0)
  {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
    analogWrite(pwm, speed);
  }
  else if (speed < 0)
  {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
    analogWrite(pwm, -speed);
  }
  else
  {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
    analogWrite(pwm, 0);
  }
}

void setMotor(int leftSpeed, int rightSpeed)
{
  driveChannel(LEFT_IN1, LEFT_IN2, LEFT_PWM, leftSpeed);
  driveChannel(RIGHT_IN1, RIGHT_IN2, RIGHT_PWM, rightSpeed);
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  pinMode(LEFT_IN1, OUTPUT);
  pinMode(LEFT_IN2, OUTPUT);
  pinMode(LEFT_PWM, OUTPUT);

  pinMode(RIGHT_IN1, OUTPUT);
  pinMode(RIGHT_IN2, OUTPUT);
  pinMode(RIGHT_PWM, OUTPUT);

  // Start stopped
  setMotor(0, 0);

  Serial.println();
  Serial.println("=================================");
  Serial.println("    L298N MOTOR POLARITY TEST");
  Serial.println("=================================");
  Serial.println();
  Serial.println("LEFT  = Ch B (ENB=");  Serial.print(LEFT_PWM);
  Serial.println(", IN3, IN4)");
  Serial.println("RIGHT = Ch A (ENA=");  Serial.print(RIGHT_PWM);
  Serial.println(", IN1, IN2)");
  Serial.println();
  Serial.println("Enter leftSpeed,rightSpeed");
  Serial.println("Range: -200 to 200");
  Serial.println("Positive = forward, negative = reverse, 0 = stop");
  Serial.println();
  Serial.println("Bench checklist (HARDWARE.md section 7):");
  Serial.println("  150,150   expect straight forward");
  Serial.println("  150,-150  expect pivot in place");
  Serial.println("  -150,150  expect pivot the other way");
  Serial.println("  150,50    expect an arc");
  Serial.println();
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
  if (!Serial.available())
  {
    return;
  }

  String input = Serial.readStringUntil('\n');

  input.trim();

  int commaIndex = input.indexOf(',');

  if (commaIndex == -1)
  {
    // Accept a space-separated pair too: "150 -150" is what most people type.
    int spaceIndex = input.indexOf(' ');
    if (spaceIndex == -1)
    {
      Serial.println("ERROR: use leftSpeed,rightSpeed");
      return;
    }
    commaIndex = spaceIndex;
  }

  String leftString  = input.substring(0, commaIndex);
  String rightString = input.substring(commaIndex + 1);

  leftString.trim();
  rightString.trim();

  int leftSpeed  = leftString.toInt();
  int rightSpeed = rightString.toInt();

  setMotor(leftSpeed, rightSpeed);

  Serial.print("LEFT = ");
  Serial.print(leftSpeed);

  Serial.print("    RIGHT = ");
  Serial.println(rightSpeed);
}
